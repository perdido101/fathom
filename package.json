{
  "name": "shadow-armada",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shadow Armada — fast hidden-information naval PvP, wagered on Solana.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx src/sim/cli.ts",
    "sim:quick": "tsx src/sim/cli.ts --matches 200",
    "smoke": "node scripts/smoke.mjs",
    "manifest": "tsx scripts/manifest.ts",
    "bundle": "node scripts/bundle.mjs",
    "icons": "node scripts/fetch-icons.mjs",
    "audio": "node scripts/fetch-audio.mjs",
    "gemini": "tsx scripts/gemini-assets.ts",
    "chain:build": "cd chain/program && cargo-build-sbf --arch v3",
    "chain:local": "bash scripts/chain-local.sh",
    "e2e:chain": "tsx scripts/e2e-chain.ts",
    "e2e:net": "tsx scripts/e2e-net.ts",
    "serve": "tsx scripts/serve.ts",
    "screens": "node scripts/screens.mjs",
    "clips": "node scripts/clips.mjs",
    "guide": "tsx scripts/screen-guide.ts && node scripts/guide-pdf.mjs && tsx scripts/guide-docx.ts",
    "guide:docx": "tsx scripts/guide-docx.ts",
    "feedback": "tsx scripts/feedback-doc.ts",
    "inventory": "tsx scripts/ui-inventory.ts"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@solana/web3.js": "^1.98.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.2",
    "docx": "^9.7.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
